PG_USER=agent
PG_PASSWORD=agent
PG_DATABASE=agent_backend
PG_HOST=127.0.0.1
PG_PORT=5432
DATABASE_URL=postgresql+asyncpg://agent:agent@127.0.0.1:5432/agent_backend
TABLE_PREFIX=agent_
AGENT_BACKEND=echo
MODEL=qwen-plus
AGENT_MODEL=qwen-plus
# Root directory DeepAgents may read to discover local skills. Keep `skills/`
# below this directory when copying shared skills to another agent project.
# AGENT_FILESYSTEM_ROOT=/path/to/deepagent_interface
# Comma-separated skill roots relative to AGENT_FILESYSTEM_ROOT.
AGENT_SKILLS_PATHS=skills
# Enterprise policy MCP; token may be read from the existing KB .env (only MCP_AUTH_TOKEN).
POLICY_MCP_URL=http://10.1.80.12:9020/mcp
# POLICY_MCP_TOKEN=
POLICY_MCP_ENV_FILE=/opt/Workspace/CRX/enterprice_policy_kb/.env
MAX_TOOL_CALLS=10
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_SCHEME=https
# Image generation is disabled until these settings are configured.
IMAGE_GENERATION_ENABLED=false
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-1
# Empty uses the provider's default response representation. Standard OpenAI
# image models return b64_json; URL-returning compatible providers may use `url`.
IMAGE_RESPONSE_FORMAT=
IMAGE_OUTPUT_EXTENSION=png
IMAGE_DEFAULT_SIZE=1024x1024
IMAGE_ALLOWED_SIZES=1024x1024,1536x1024,1024x1536
# Agent-friendly aspect ratios are resolved to actual provider size values.
IMAGE_ASPECT_RATIO_SIZES=1:1=1024x1024,16:9=1536x1024,9:16=1024x1536
# For doubao-seedream-5-0-260128, use its resolution presets instead:
# IMAGE_DEFAULT_SIZE=2K
# IMAGE_ALLOWED_SIZES=1K,1.5K,2K
IMAGE_DEFAULT_WATERMARK=true
# Empty means standard OpenAI Images behavior: no watermark parameter is sent.
# For a compatible provider with a watermark extension, set e.g. `watermark`.
IMAGE_WATERMARK_FIELD=
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=120
IMAGE_UPLOAD_PREFIX=generated
IMAGE_UPLOAD_PART_SIZE_MB=10
IMAGE_UPLOAD_MAX_THREADS=5
IMAGE_UPLOAD_ACL=public-read
PUBLIC_BASE_URL=http://127.0.0.1:8000
BOCHA_API_KEY=
BOCHA_API_URL=https://api.bocha.cn/v1/ai-search
MODEL_GUARD_ENABLED=true
MODEL_GUARD_RESPONSE=
